---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section id="home" class="hero-section" style="flex-direction: column;">
    <img src="https://i.ytimg.com/vi/PkZ5PSclxp0/maxresdefault.jpg" alt="Still from Egg, a short film directed by Lukas Deemer" class="hero-image" />
    <h1 class="hero-name">Lukas Deemer</h1>
    <p style="position: relative; z-index: 1; color: white; font-size: 1.5rem; margin: 10px 0 0; letter-spacing: 1px; text-shadow: 2px 4px 10px rgba(0, 0, 0, 0.7); text-align: center;">Filmmaker · Actor · Editor</p>
  </section>

  <section id="showreel" class="content-section">
    <div class="section-container">
      <h2 class="section-title">Featured Film: Egg</h2>

      <div style="max-width: 900px; width: 100%; margin: 0 auto; aspect-ratio: 16 / 9; border-radius: 15px; overflow: hidden; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);">
        <iframe src="https://www.youtube.com/embed/PkZ5PSclxp0" title="Egg | Short Film" style="width: 100%; height: 100%; border: 0;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
      </div>

    </div>
  </section>

  <section id="film-acting" class="content-section alternate-bg">
    <div class="section-container">
      <h2 class="section-title">Film & Acting</h2>

      <div class="three-column-grid">
        <div class="film-card">
          <a href="https://www.youtube.com/watch?v=PkZ5PSclxp0" target="_blank">
            <img src="https://i.ytimg.com/vi/PkZ5PSclxp0/maxresdefault.jpg" alt="Title card from Egg" class="film-thumbnail" />
          </a>
          <h3 class="film-title">Egg | Short Film</h3>
          <p class="film-description">A psychological thriller about a hitman who is knocked unconscious and must navigate an ethereal plane of self-exploration.</p>
        </div>

        <div class="film-card">
          <a href="https://www.youtube.com/watch?v=82Xswk8K5lY" target="_blank">
            <img src="https://i.ytimg.com/vi/82Xswk8K5lY/maxresdefault.jpg" alt="Still from S.T.P." class="film-thumbnail" />
          </a>
          <h3 class="film-title">S.T.P. | Music Video</h3>
          <p class="film-description">An unofficial music video for Sublime's "S.T.P.," screened at a local theater's student film showing.</p>
        </div>

        <div class="film-card">
          <a href="https://www.youtube.com/watch?v=bU27NlyQEow" target="_blank">
            <img src="https://i.ytimg.com/vi/bU27NlyQEow/maxresdefault.jpg" alt="Title card from TERMINALITY" class="film-thumbnail" />
          </a>
          <h3 class="film-title">TERMINALITY | Short Film</h3>
          <p class="film-description">A psychological thriller about dementia, told through motifs such as a giant brown marmorated stink bug and a flood of blood.</p>
        </div>
      </div>

      <h3 class="subsection-title" style="margin-bottom: 15px;">Experience & Background</h3>

      <div class="resume-download-wrapper">
        <a href="/Lukas_Deemer_Resume.pdf" target="_blank" class="download-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          Download Full Resume
        </a>
      </div>

      <div class="experience-list" style="margin-top: 40px;">

        <div class="experience-item">
          <div class="experience-meta">
            <h3 class="experience-role">Actor</h3>
            <span class="experience-year">Fall 2026</span>
          </div>
          <div class="experience-details">
            <h4 class="experience-project">The King Stag (Play)</h4>
            <p class="experience-desc">Playing King Deramo. Directed by Mark Cosdon. Performances November 20–22, 2026.</p>
          </div>
        </div>

        <div class="experience-item">
          <div class="experience-meta">
            <h3 class="experience-role">Videographer</h3>
            <span class="experience-year">Fall 2026</span>
          </div>
          <div class="experience-details">
            <h4 class="experience-project">Ladyfest Documentary (Women's Services, Meadville, PA)</h4>
            <p class="experience-desc">Filmed a downtown arts and music festival fundraiser and conducted a five-person group interview for a paid documentary project supporting the organization's donation drive.</p>
          </div>
        </div>

        <div class="experience-item">
          <div class="experience-meta">
            <h3 class="experience-role">Director, Producer & Co-writer</h3>
            <span class="experience-year">Spring 2026</span>
          </div>
          <div class="experience-details">
            <h4 class="experience-project">Egg (Short Film)</h4>
            <p class="experience-desc">Final film for Filmmaking 2. Co-wrote, directed, produced, starred in, and edited this 11.5-minute psychological thriller. Led a cast and crew of about nine, from recruiting and scheduling to locations, props, lighting, and sound design.</p>
          </div>
        </div>

        <div class="experience-item">
          <div class="experience-meta">
            <h3 class="experience-role">Supporting Actor</h3>
            <span class="experience-year">Spring 2026</span>
          </div>
          <div class="experience-details">
            <h4 class="experience-project">Marie Antoinette (Play)</h4>
            <p class="experience-desc">Played the role of Mr. Sauce. Directed by Mark Cosdon. Collaborated with the ensemble cast to bring the historical setting to life on stage with dynamic character work.</p>
          </div>
        </div>

        <div class="experience-item">
          <div class="experience-meta">
            <h3 class="experience-role">Lead Actor</h3>
            <span class="experience-year">Fall 2025</span>
          </div>
          <div class="experience-details">
            <h4 class="experience-project">Space Cat (Play)</h4>
            <p class="experience-desc">Starred as the Astronaut. Directed by Michael Mehler. Anchored the production through an expressive stage performance without the ability to move.</p>
          </div>
        </div>

        <div class="experience-item">
          <div class="experience-meta">
            <h3 class="experience-role">Lead Actor</h3>
            <span class="experience-year">Fall 2025</span>
          </div>
          <div class="experience-details">
            <h4 class="experience-project">Steamy Session in a Singapore Spa (Play)</h4>
            <p class="experience-desc">Played the lead role of Spa User. Directed by Michael Mehler. Explored dynamic interpersonal themes and advanced stage acting techniques.</p>
          </div>
        </div>

        <div class="experience-item">
          <div class="experience-meta">
            <h3 class="experience-role">Lead Actor</h3>
            <span class="experience-year">Spring 2025</span>
          </div>
          <div class="experience-details">
            <h4 class="experience-project">This Random World (Play)</h4>
            <p class="experience-desc">Played the role of Tim Ward. Directed by Mark Cosdon. Handled complex dialogue and emotional arcs to drive the core narrative of the play.</p>
          </div>
        </div>

      </div>

      <h3 class="subsection-title" style="margin-top: 80px;">Future Plans</h3>

      <div class="split-layout">
        <div class="text-content">
          <p>Lukas Deemer is a Theatre major at Allegheny College with a minor in Software Engineering and a minor in Filmmaking in progress. He is applying to Carnegie Mellon University's Heinz College through Allegheny's 3-2 program to earn a Master of Entertainment Industry Management (MEIM), with both degrees expected in May 2029.</p>
          <p>Alongside his classes and stage work, Lukas writes, directs, and edits short films and shares them on his YouTube channel. He wants to work directly on film and television projects, bringing together his training in performance, production, and management.</p>
        </div>

        <div class="media-content">
          <img src="/img/HeadshotForSite.jpg" alt="Headshot of Lukas Deemer" class="placeholder-media" />
        </div>
      </div>

    </div>
  </section>

  <section id="editing" class="content-section">
    <div class="section-container">
      <h2 class="section-title">Video Editing</h2>

      <div class="expertise-text">
        <p>Editing since April 2022, from YouTube videos to short films. Experienced in color correction, sound design, and visual effects, including reversed and pitched music, 2D cutout animation, and layered audio.</p>
      </div>

      <div class="three-column-grid">
        <div class="film-card">
          <h3 class="film-title">Wondershare Filmora</h3>
          <p class="film-description">Primary editor for all short films</p>
        </div>

        <div class="film-card">
          <h3 class="film-title">Premiere Pro & After Effects</h3>
          <p class="film-description">Editing and effects work</p>
        </div>

        <div class="film-card">
          <h3 class="film-title">Photoshop</h3>
          <p class="film-description">Built the 2D cutout character animated in TERMINALITY</p>
        </div>
      </div>
    </div>
  </section>

  <section id="youtube" class="content-section alternate-bg">
    <div class="section-container">
      <h2 class="section-title">YouTube Content</h2>

      <div class="expertise-text">
        <p>Check out Lukas's latest content on <a href="https://www.youtube.com/@Lukas1950" target="_blank" style="color: var(--accent-color); text-decoration: none; font-weight: bold;">@Lukas1950</a>. Scroll through his short films below!</p>
      </div>

      <div class="video-carousel">
        <div class="video-wrapper">
          <iframe src="https://www.youtube.com/embed/bU27NlyQEow" title="TERMINALITY | Short Film" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
        <div class="video-wrapper">
          <iframe src="https://www.youtube.com/embed/82Xswk8K5lY" title="S.T.P. | Music Video (Unofficial)" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
        <div class="video-wrapper">
          <iframe src="https://www.youtube.com/embed/E6uH69HJN1M" title="The Roommates | Short Film" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
        <div class="video-wrapper">
          <iframe src="https://www.youtube.com/embed/T9Dmm-qokH4" title="Laugh Man | Short Film" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
        <div class="video-wrapper">
          <iframe src="https://www.youtube.com/embed/k5RjAIJt6uY" title="Heretic &quot;Creep&quot; Scene Recreation" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
        <div class="video-wrapper">
          <iframe src="https://www.youtube.com/embed/Ic_MWojEO58" title="contingency | Short Film" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
        <div class="video-wrapper">
          <iframe src="https://www.youtube.com/embed/m2wEKuS8KnQ" title="An Analysis Of My 4 Short Films" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="content-section">
    <div class="section-container">
      <h2 class="section-title">Get In Touch</h2>

      <div class="availability-status">
        <span class="status-dot"></span>
        <span class="status-text">Open to New Projects</span>
      </div>

      <div class="contact-layout">

        <div class="contact-form-container">
          <h3 class="contact-subtitle">Send Lukas a message</h3>
          <form action="https://formsubmit.co/lukasdeemer@gmail.com" method="POST" class="contact-form">
            <input type="hidden" name="_captcha" value="false">

            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required placeholder="Your Name">
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required placeholder="Your Email Address">
            </div>

            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" required maxlength="500" placeholder="Type your message here (Max 500 characters)"></textarea>
            </div>

            <button type="submit" class="submit-btn">Send Message</button>
          </form>
        </div>

        <div class="social-links-container">
          <h3 class="contact-subtitle">Find Lukas online</h3>
          <div class="social-grid">

            <a href="https://www.youtube.com/@Lukas1950/featured" target="_blank" class="social-card">
              <img src="https://cdn.simpleicons.org/youtube/FF0000" alt="YouTube Icon" class="social-icon" />
              <span>YouTube</span>
            </a>

            <a href="https://www.backstage.com/u/Lukas-Deemer/" target="_blank" class="social-card">
              <img src="https://www.google.com/s2/favicons?domain=backstage.com&sz=128" alt="Backstage Icon" class="social-icon" />
              <span>Backstage</span>
            </a>

            <a href="https://www.castingcall.club/lukas-deemer" target="_blank" class="social-card">
              <img src="https://www.google.com/s2/favicons?domain=castingcall.club&sz=128" alt="Casting Call Club Icon" class="social-icon" />
              <span>Casting Call Club</span>
            </a>

            <a href="https://www.instagram.com/mixer_lukas1950/" target="_blank" class="social-card">
              <img src="https://cdn.simpleicons.org/instagram/E4405F" alt="Instagram Icon" class="social-icon" />
              <span>Instagram</span>
            </a>

          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>